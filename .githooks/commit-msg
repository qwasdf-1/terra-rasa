#!/usr/bin/env sh
# Rejects tool-generated co-author trailers and footers, so commits carry their human author only.
set -eu
if grep -inE '^[[:space:]]*co-authored-by:.*(claude|anthropic\.com)|generated with \[?claude code' "$1" >&2; then
  echo "commit-msg: remove the generated attribution line(s) above; commits carry their human author only." >&2
  exit 1
fi
