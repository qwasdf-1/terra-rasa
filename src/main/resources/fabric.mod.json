{
  "schemaVersion": 1,
  "id": "terrarasa",
  "version": "${version}",
  "name": "Terra Rasa",
  "description": "Swaps freshly seeded, pre-generated canonical dimensions into a running dedicated server without reconnecting players.",
  "authors": ["Terra Rasa Contributors"],
  "license": "Apache-2.0",
  "contact": {
    "sources": "https://github.com/qwasdf-1/terra-rasa",
    "issues": "https://github.com/qwasdf-1/terra-rasa/issues"
  },
  "environment": "server",
  "entrypoints": {
    "main": ["dev.terrarasa.TerraRasaInitializer"]
  },
  "mixins": ["${mixins_config}"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
