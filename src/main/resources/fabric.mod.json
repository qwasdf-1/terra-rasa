{
  "schemaVersion": 1,
  "id": "terrarasa",
  "version": "${version}",
  "name": "Terra Rasa",
  "description": "Prepares and swaps freshly seeded canonical dimensions on dedicated and integrated servers.",
  "authors": ["Terra Rasa Contributors"],
  "license": "Apache-2.0",
  "contact": {
    "sources": "https://github.com/qwasdf-1/terra-rasa",
    "issues": "https://github.com/qwasdf-1/terra-rasa/issues"
  },
  "environment": "*",
  "entrypoints": {
    "main": ["dev.terrarasa.TerraRasaInitializer"]
  },
  "mixins": ["${mixins_config}"],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
